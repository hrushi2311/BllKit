<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net452;netstandard2.0;netstandard2.1</TargetFrameworks>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>disable</ImplicitUsings>

    <PackageId>BllKit</PackageId>
    <Version>1.0.1</Version>
    <Authors>Paturu Hrushikesh Reddy</Authors>
    <Company>Hrubi</Company>
    <Product>BllKit</Product>
    <Description>A lightweight Business Logic Layer toolkit for .NET that eliminates repetitive try/catch boilerplate, standardizes API responses, and provides fluent guard validations. Compatible with .NET Framework 4.5.2+ and .NET Core/5/6/7/8.</Description>
    <PackageTags>bll;api;response;guard;result;pattern;netframework;netstandard;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/hrushi2311/BllKit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/hrushi2311/BllKit</PackageProjectUrl>
    <Copyright>Copyright 2026 Paturu Hrushikesh Reddy</Copyright>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
